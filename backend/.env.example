# Salin menjadi .env lalu isi. JANGAN commit file .env.
# Ambil API key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model dibuat konfigurasi karena kuota free tier bisa berubah.
# Cek model + kuota yang tersedia di Google AI Studio (halaman Rate limits).
# Kalau kena limit terus, coba model Flash-Lite, mis. gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.8-flash

# Free tier dibatasi per model (mis. hanya 5 permintaan/menit untuk gemini-3.8-flash).
# Saat model utama kena limit, server otomatis mencoba model-model ini berurutan.
# Kosongkan untuk menonaktifkan.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

PORT=3000
HOST=0.0.0.0

# Opsional: kalau diisi, app wajib mengirim header x-app-key yang sama.
# Hanya untuk mengurangi penyalahgunaan iseng, BUKAN autentikasi sungguhan.
APP_KEY=

# Batas permintaan /api/chat per IP per menit.
RATE_LIMIT_PER_MINUTE=20
